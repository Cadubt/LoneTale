###############################################################################
# LoneTale — variáveis de ambiente
#
# Copie para `.env` na raiz do repositório e ajuste. O arquivo `.env` está no
# .gitignore: nunca comite credenciais.
###############################################################################

# --------------------------------------------------------------- aplicação
NODE_ENV=development
PORT=3333
API_PREFIX=api
# Origens autorizadas do frontend, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173
# Swagger fica em /api/docs. Padrão: ligado fora de produção.
SWAGGER_ENABLED=true

# ------------------------------------------------- SQL Server (obrigatório)
#
# O LoneTale usa um servidor e um banco QUE JÁ EXISTEM, possivelmente
# compartilhados com outras aplicações. Toda a estrutura própria vive no schema
# `lonetale` — nada é criado em `dbo`, nada fora do schema é alterado.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=TavernTale
# Usuário da aplicação: aplique o princípio do menor privilégio.
# Permissões suficientes: SELECT/INSERT/UPDATE/DELETE no schema `lonetale`.
#   GRANT SELECT, INSERT, UPDATE, DELETE ON SCHEMA::lonetale TO [lonetale_app];
DB_USERNAME=lonetale_app
DB_PASSWORD=troque-esta-senha

# Instância nomeada (opcional). Quando usada, a porta é ignorada.
# DB_INSTANCE_NAME=SQLEXPRESS

# Criptografia da conexão. Mantenha DB_ENCRYPT=true.
# DB_TRUST_SERVER_CERTIFICATE=true aceita certificado autoassinado — útil em
# desenvolvimento, perigoso em produção (não valida o servidor).
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000
DB_POOL_MIN=0
DB_POOL_MAX=10
# Registra todas as queries no log. Use só para depurar.
DB_LOGGING=false

# ------------------------------------------- credenciais das migrations
#
# Separe as credenciais administrativas das de execução. As migrations precisam
# de CREATE TABLE / ALTER no schema `lonetale`; a aplicação, não.
# Se ausentes, as migrations usam DB_USERNAME/DB_PASSWORD.
# DB_ADMIN_USERNAME=lonetale_migrator
# DB_ADMIN_PASSWORD=troque-esta-senha

# Permite que a aplicação crie o schema `lonetale` no arranque, caso não exista.
# Desligado por padrão: em banco compartilhado, criar schema é ato do DBA.
DB_ALLOW_SCHEMA_CREATION=false

# --------------------------------------------------------- autenticação
#
# Gere segredos distintos, com 32+ caracteres:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso-com-32-caracteres-ou-mais
JWT_REFRESH_SECRET=troque-este-segredo-de-renovacao-com-32-caracteres-ou-mais
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=lonetale.taverntale.com.br
JWT_AUDIENCE=lonetale-player

# ------------------------------------------- Google (OpenID Connect)
#
# Opcional. As três variáveis precisam estar presentes juntas, senão o login
# com Google fica desativado.
# Console: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/entrar
# GOOGLE_ISSUER=https://accounts.google.com

# ------------------------------------------------------------ testes
#
# Semente fixa para as rolagens: torna as partidas reproduzíveis.
# A aplicação recusa subir em produção se esta variável estiver definida.
# GAME_DETERMINISTIC_SEED=lonetale-testes

# --------------------------------------------------------------- frontend
# Proxy do Vite em desenvolvimento (aponta para a API).
VITE_API_PROXY=http://localhost:3333
# Base da API vista pelo navegador. Em dev, o proxy do Vite serve /api.
# VITE_API_BASE=/api
