{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // Compilacao incremental desligada de proposito: o `.tsbuildinfo` fica ao
    // lado do tsconfig, nao dentro de `dist`. Apagar `dist` deixava o
    // compilador convencido de que ja estava tudo emitido, e a build saia
    // vazia sem erro nenhum. Estes pacotes compilam em segundos; o ganho nao
    // paga o tipo de confusao que isso causa.
    "incremental": false,
    "pretty": true
  },
  "exclude": ["node_modules", "dist"]
}
