      "title": "A beira do mundo",
      "text": "A floresta se abre de repente e o chão simplesmente termina.",
      "visual": { "position": { "x": 520, "y": 0 }, "color": "#8e8e8e" },
      "continueNodeId": "ponte-de-pedra"
    },

    {
      "id": "ponte-de-pedra",
      "type": "story",
      "title": "A ponte quebrada",
      "text": "À sua frente, uma antiga ponte de pedra atravessa um abismo. Parte da construção desmoronou. Um guardião observa silenciosamente sua aproximação.",
      "image": "img-ponte",
      "audio": { "musicAssetId": "som-tensao", "loop": true, "volume": 0.5, "fadeMs": 1200 },
      "visual": { "position": { "x": 780, "y": 0 }, "color": "#b06f3c", "icon": "bridge" },
      "onEnter": [
        { "type": "incrementFlag", "flag": "vezes-na-ponte", "delta": 1 },
        {
          "id": "quest.travessia.iniciar",
          "mode": "once",
          "type": "setQuestStatus",
          "questId": "travessia",
          "status": "active",
          "stage": 1
        }
      ],
      "choices": [
        {
          "id": "usar-corda",
          "label": "Usar a corda para atravessar o vão",
          "description": "Amarrar uma ponta no pilar e confiar nos braços.",
          "order": 1,
          "conditions": { "type": "hasItem", "itemId": "corda" },
          "unavailableBehavior": "disable",
          "unavailableLabel": "Você precisaria de uma corda.",
          "target": { "kind": "node", "nodeId": "travessia-com-corda" }
        },
        {
          "id": "usar-levitacao",
          "label": "Conjurar levitação e flutuar sobre o abismo",
          "order": 2,
          "conditions": {
            "type": "all",
