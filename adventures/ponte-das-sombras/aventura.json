  "nodes": [
    {
      "id": "introducao",
      "type": "story",
      "title": "A Ponte das Sombras",
      "text": "Contam em Vharlen que a ponte caiu na mesma noite em que o último guardião foi posto a vigiá-la. Ninguém soube dizer o que veio primeiro.\n\nCem anos depois, você é a única pessoa que ainda acha que vale a pena atravessar.\n\nNão há ninguém para ajudar. Não há ninguém para culpar. O que você levar na mochila e o que você escolher no caminho é tudo o que existe entre você e o outro lado.",
      "image": "img-capa",
      "checkpoint": true,
      "visual": { "position": { "x": -260, "y": 0 }, "color": "#d2721f", "icon": "book" },
      "choices": [
        {
          "id": "comecar",
          "label": "Começar a jornada",
          "order": 1,
          "target": { "kind": "node", "nodeId": "clareira-inicial" }
        }
      ]
    },

    {
      "id": "clareira-inicial",
      "type": "story",
      "title": "A clareira",
      "text": "A chuva parou há pouco e a terra ainda cede sob suas botas. Ao norte, a floresta antiga se fecha sobre a trilha. Em algum lugar além dela, dizem, há ruínas que ninguém visita há cem anos.",
      "image": "img-floresta",
      "audio": { "ambienceAssetId": "som-floresta", "loop": true, "volume": 0.4 },
      "checkpoint": true,
      "visual": { "position": { "x": 0, "y": 0 }, "color": "#3b7a57" },
      "choices": [
        {
          "id": "seguir-trilha",
          "label": "Seguir a trilha para o norte",
          "order": 1,
          "target": { "kind": "node", "nodeId": "floresta-antiga" }
        }
      ]
    },

    {
      "id": "floresta-antiga",
      "type": "story",
      "title": "Floresta antiga",
      "text": "Os troncos são largos demais para serem abraçados e a luz chega filtrada, esverdeada. Há um cheiro de musgo molhado e, mais adiante, o som oco de vento passando por um vão muito grande.",
      "image": "img-floresta",
      "visual": { "position": { "x": 260, "y": 0 } },
      "choices": [
        {
          "id": "revirar-matagal",
          "label": "Revirar o matagal à procura de suprimentos",
          "description": "Algo brilha entre as raízes.",
          "order": 1,
          "once": true,
          "target": { "kind": "node", "nodeId": "descoberta-corda" }
        },
        {
          "id": "procurar-mercador",
          "label": "Chamar pelo mascate que acampa por aqui",
          "order": 2,
          "target": { "kind": "node", "nodeId": "mercador-ambulante" }
        },
        {
          "id": "ir-ao-desfiladeiro",
          "label": "Seguir o som do vento",
          "order": 3,
          "target": { "kind": "node", "nodeId": "ponto-de-retomada" }
        }
      ]
    },

    {
      "id": "descoberta-corda",
      "type": "discovery",
      "title": "Entre as raízes",
      "text": "Enrolada no tronco caído, meio enterrada, uma corda de cânhamo em bom estado. Quem a deixou ali não voltou para buscá-la.",
      "image": "img-corda",
      "visual": { "position": { "x": 260, "y": -180 } },
      "rewards": [
        {
          "id": "recompensa.corda-da-floresta",
          "mode": "once",
          "type": "addItem",
          "itemId": "corda",
          "quantity": 1
        },
        {
          "id": "recompensa.xp-corda",
          "mode": "once",
          "type": "grantExperience",
          "amount": 15
        }
      ],
      "continueNodeId": "floresta-antiga"
    },

    {
      "id": "mercador-ambulante",
      "type": "merchant",
      "title": "O acampamento de Oswin",
      "text": "— Corda? Tenho. Poção? Tenho duas, três. Conselho é de graça: não confie em ponte velha.",
      "npcId": "mercador-ambulante",
      "visual": { "position": { "x": 260, "y": 180 } },
      "stock": [
        { "itemId": "corda", "price": 25 },
        { "itemId": "pocao-de-cura", "price": 30, "quantity": 3 },
        { "itemId": "armadura-de-couro", "price": 70, "quantity": 1 },
        { "itemId": "tocha", "price": 6 }
      ],
