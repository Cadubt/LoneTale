{
  "name": "@lonetale/api",
  "version": "0.1.0",
  "private": true,
  "description": "LoneTale API: autenticacao, Adventure Studio, catalogo e execucao autoritativa das partidas.",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "node --watch -r ts-node/register src/main.ts",
    "migration:run": "node -r ts-node/register ../../node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:revert": "node -r ts-node/register ../../node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "migration:show": "node -r ts-node/register ../../node_modules/typeorm/cli.js migration:show -d src/database/data-source.ts",
    "migration:generate": "node -r ts-node/register ../../node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "seed": "node -r ts-node/register src/database/seed.ts"
  },
  "dependencies": {
    "@lonetale/engine": "0.1.0",
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/throttler": "6.2.1",
    "@nestjs/typeorm": "10.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "dotenv": "16.4.5",
    "helmet": "7.2.0",
    "mssql": "10.0.2",
    "openid-client": "5.7.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.20"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.12.12",
    "@types/passport-jwt": "4.0.1",
    "ts-node": "10.9.2",
    "typescript": "5.4.5"
  }
}
